# ===========================================================================
# Project .gitignore
# NOTE: unanchored dir patterns match at ANY depth and Git on Windows/macOS
# matches case-insensitively -- so root-only dirs (env/, ENV/, build/, ...) are
# anchored with a leading "/" to avoid swallowing package dirs like dota_rl/env/.
# ===========================================================================

# --- Python bytecode / C extensions ---------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Packaging / build (root only) --------------------------------------
/build/
/dist/
/wheels/
/pip-wheel-metadata/
/*.egg-info/
/.eggs/
*.egg
MANIFEST

# --- Virtual environments (root only) ----------------------------------
/.venv/
/venv/
/env/
/ENV/
/.python-version

# --- Testing / coverage / linters / type checkers -------------------------
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# --- Jupyter / IPython ---------------------------------------------------
.ipynb_checkpoints/

# --- RL / experiment artifacts (root only) -----------------------------
/runs/
/outputs/
/logs/
/wandb/
/mlruns/
/lightning_logs/
/tb/
/tensorboard/
events.out.tfevents.*

# --- Model weights ----------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.h5
*.safetensors

# --- Project-specific --------------------------------------------------------
api_probe_result.json
*.log
/web/data.json          # generated by scripts/build_web.py (stale fast)
/web/index.html         # template.html + baked data -- regenerate, don't commit

# --- Secrets / local config ------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- Editors / IDEs -------------------------------------------------------
/.vscode/
/.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
