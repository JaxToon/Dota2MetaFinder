# ===========================================================================
# Project root .gitignore
# Patterns are recursive, so these also cover dota-rl/ .
# The source documents (Blueprint_RL_Dota2_Revisi.md,
# Dota2_RL_Technical_Development_Specification.pdf) are deliverables -> tracked.
# ===========================================================================

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Testing / coverage / linters / type checkers --------------------------
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# --- Jupyter / IPython ------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# --- RL / experiment artifacts -------------------------------------------------
runs/
outputs/
logs/
checkpoints/
wandb/
mlruns/
lightning_logs/
tb/
tensorboard/
events.out.tfevents.*

# --- Model weights -------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.h5
*.safetensors

# --- Project-specific --------------------------------------------------------
api_probe_result.json
*.log

# --- Secrets / local config ------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- Editors / IDEs -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
