# Normalise line endings: store text as LF in the repo, check out native.
* text=auto eol=lf

# Windows batch/PowerShell keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Explicit binaries (never touch line endings / show diffs)
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pt   binary
*.pth  binary
*.ckpt binary
*.onnx binary
*.safetensors binary
*.pkl  binary
*.h5   binary
